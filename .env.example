# Copy to ".env" and adjust before "docker compose up".
# Admin password for the VANTHEX dashboard (user: admin). REQUIRED:
# docker compose refuses to start while this is unset, and the app has
# no built-in default password. Use a long random value.
PTK_ADMIN_PW=change-me-to-a-long-random-password

# Optional: NVD API key for faster CVE cache syncs (https://nvd.nist.gov/developers/request-an-api-key)
PTK_NVD_KEY=

# Optional: comma-separated allowlist of scan targets (empty = no extra restriction)
PTK_ALLOWED_TARGETS=

# Optional: public base URL of the canary listener for out-of-band tests
PTK_CANARY_BASE=

# Only for docker-compose.deploy.yml (prebuilt image from GHCR):
# your GitHub username/organization (lowercase) and the image tag to run.
GHCR_OWNER=faudzanulhakim
GHCR_REPO=vanthex-osp
VANTHEX_TAG=latest

# Optional: mark session cookies Secure (use behind HTTPS)
PTK_COOKIE_SECURE=
# Optional: company name printed on exported reports
PTK_COMPANY=
# Optional: canary listener port (default 8977)
PTK_CANARY_PORT=
# Optional: egress proxy for the web layer (or standard HTTP(S)_PROXY)
PTK_PROXY=

# Auth Annihilation Pack (operator-gated; leave empty to keep modules idle):
# PTK_AUTHATTACK=1  -> login brute/stuffing, rate-limit evasion, OTP/MFA attacks
# PTK_JWTRED=1      -> JWT forgery & auth-flow attacks (VANTHEX_JWTRED also accepted)
# PTK_AUTHZ=1       -> IDOR/BOLA matrix & privilege-escalation probes
#PTK_AUTHATTACK=
#PTK_JWTRED=
#PTK_AUTHZ=

# Optional platform toggles:
# PTK_DISABLE_RBAC=1  disable role enforcement (admin/operator/viewer)
# PTK_THREATPRIOR=0   disable EPSS/KEV enrichment
# PTK_ATTACKGRAPH=0   disable attack-graph chaining
# PTK_LATERALMAP=0    disable the lateral movement map
# PTK_HEAL=0          disable self-healing probe retries

# Optional P1 notifications (sent only when a P1 finding exists):
# PTK_NOTIFY_TELEGRAM_BOT_TOKEN=
# PTK_NOTIFY_TELEGRAM_CHAT_ID=
# PTK_NOTIFY_SLACK_WEBHOOK=
# PTK_NOTIFY_WEBHOOK_URL=
# PTK_NOTIFY_ALWAYS=1   (send for every scan, not only P1)

# Optional: cache file for the CISA KEV feed (default: state dir, TTL 24h)
# PTK_KEV_PATH=

# ------------------------------------------------------------------
# Operator-gated offensive modules (ALL DEFAULT OFF — set to 1 to enable).
# Each gate enables an extra check class in the enterprise-full profile.
# ------------------------------------------------------------------
# PTK_GRAPHQL=1      # GraphQL attack suite (introspection bypass, batching)
# PTK_PROTO=1        # HTTP/2 + race-condition probes
# PTK_LLMV2=1        # LLM/AI prompt-injection attack suite
# PTK_ZERODAY=1      # Behavioral zero-day heuristics fuzzer
# PTK_LOGIC=1        # Business-logic replay (also needs HAR + approve)
# PTK_WAFCHAIN=1     # WAF fingerprint -> auto-bypass chain
# PTK_RECON=1        # Passive recon: crt.sh, wayback, JS secrets
# PTK_CSMINE=1       # Client-side taint mining (source -> sink)
# PTK_CHAOS=1        # Chaos fault injection
# PTK_DARKRADAR=1    # Dark-web exposure radar (links-only)
# PTK_PROMPTFUZZ=1   # Free-text prompt-attack fuzzing
# PTK_GHOST=1        # Stealth crawl (jitter + cache-timing enumeration)
# PTK_WS=1           # WebSocket / SSE attack suite
# PTK_CACHEATLAS=1   # Cache deception & poisoning atlas
# PTK_SIDEORACLE=1   # Timing side-channel oracles
# PTK_POLYGLOT=1     # Polyglot upload test plans
# PTK_AUTHATTACK=1   # Auth assault pack
# PTK_JWTRED=1       # JWT red-team checks (alias: VANTHEX_JWTRED)
# PTK_AUTHZ=1        # Mass-assignment / authz matrix v2
# PTK_POCBOX=1       # POC box runner (Run POC button in the UI)
