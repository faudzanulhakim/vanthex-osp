[Unit]
Description=VANTHEX - Offensive Security Platform (port 5000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/vanthex
EnvironmentFile=/home/hatch/workspace/pentest-toolkit-service/env
Environment=PYTHONPATH=/home/hatch/workspace/vanthex:/home/hatch/workspace/vanthex/webapp:/home/hatch/workspace/vanthex/engine:/home/hatch/workspace/vanthex/tools:/home/hatch/workspace/vanthex/offensive:/home/hatch/workspace/vanthex/scripts
ExecStart=/home/hatch/workspace/vanthex/.venv/bin/python webapp/app2.py 5000
Restart=always
RestartSec=3
# Hardening (kept compatible with the app's own sandbox subprocesses):
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/hatch/workspace/vanthex /home/hatch/workspace/pentest-toolkit-service
StandardOutput=append:/home/hatch/workspace/pentest-toolkit-service/logs/service.log
StandardError=append:/home/hatch/workspace/pentest-toolkit-service/logs/service.log

[Install]
WantedBy=multi-user.target
