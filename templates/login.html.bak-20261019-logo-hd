  <script>
    const updateThemeUI = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      const label = document.getElementById('themeLabel');
      const icon = document.getElementById('themeIcon');
      if (label) label.textContent = isDark ? 'Light Mode' : 'Dark Mode';
      if (icon) {
        icon.innerHTML = isDark 
          ? '<circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>'
          : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
      }
    };

    function toggleTheme() {
      const cur = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = cur;
      try { localStorage.setItem('ptk-theme', cur); } catch(e) {}
      updateThemeUI();
    }
    updateThemeUI();

    function togglePasswordVisibility() {
      const p = document.getElementById('p');
      const eye = document.getElementById('pwEye');
      if (p.type === 'password') {
        p.type = 'text';
        eye.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
      } else {
        p.type = 'password';
        eye.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
      }
    }

    const go = async () => {
      const b = document.getElementById('b');
      const errEl = document.getElementById('e');
      const errText = document.getElementById('errText');
      b.disabled = true;
      b.classList.add('loading');
      errEl.classList.remove('show');
      errText.textContent = '';

      try {
        const r = await fetch('/api/login', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({username: u.value, password: p.value})
        });
        if (r.ok) {
          location.href = '/';
        } else {
          errText.textContent = 'Invalid username or password';
          errEl.classList.add('show');
          b.disabled = false;
          b.classList.remove('loading');
        }
      } catch(err) {
        errText.textContent = 'Network or server error occurred';
        errEl.classList.add('show');
        b.disabled = false;
        b.classList.remove('loading');
      }
    };

    document.getElementById('b').onclick = go;
    document.getElementById('p').onkeydown = e => { if (e.key === 'Enter') go(); };
    document.getElementById('u').onkeydown = e => { if (e.key === 'Enter') document.getElementById('p').focus(); };

    var LOGIN_I18N = {
      id:{"Sign in":"Masuk","Username":"Nama pengguna","Password":"Kata sandi","Enterprise Security Assessment Platform":"Platform Asesmen Keamanan Enterprise","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"RAHASIA — HANYA AKSES BERWENANG","Light Mode":"Mode Terang","Dark Mode":"Mode Gelap"},
      es:{"Sign in":"Iniciar sesión","Username":"Usuario","Password":"Contraseña","Enterprise Security Assessment Platform":"Plataforma de evaluación de seguridad empresarial","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"CONFIDENCIAL — SOLO ACCESO AUTORIZADO","Light Mode":"Modo claro","Dark Mode":"Modo oscuro"},
      fr:{"Sign in":"Se connecter","Username":"Nom d'utilisateur","Password":"Mot de passe","Enterprise Security Assessment Platform":"Plateforme d'évaluation de sécurité d'entreprise","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"CONFIDENTIEL — ACCÈS AUTORISÉ UNIQUEMENT","Light Mode":"Mode clair","Dark Mode":"Mode sombre"},
      de:{"Sign in":"Anmelden","Username":"Benutzername","Password":"Passwort","Enterprise Security Assessment Platform":"Plattform für Enterprise-Sicherheitsbewertung","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"VERTRAULICH — NUR AUTORISIERTER ZUGRIFF","Light Mode":"Hellmodus","Dark Mode":"Dunkelmodus"},
      pt:{"Sign in":"Entrar","Username":"Nome de usuário","Password":"Senha","Enterprise Security Assessment Platform":"Plataforma de avaliação de segurança empresarial","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"CONFIDENCIAL — SOMENTE ACESSO AUTORIZADO","Light Mode":"Modo claro","Dark Mode":"Modo escuro"},
      ru:{"Sign in":"Войти","Username":"Имя пользователя","Password":"Пароль","Enterprise Security Assessment Platform":"Платформа оценки безопасности предприятия","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"КОНФИДЕНЦИАЛЬНО — ТОЛЬКО ДЛЯ АВТОРИЗОВАННОГО ДОСТУПА","Light Mode":"Светлый режим","Dark Mode":"Тёмный режим"},
      ja:{"Sign in":"ログイン","Username":"ユーザー名","Password":"パスワード","Enterprise Security Assessment Platform":"エンタープライズセキュリティ評価プラットフォーム","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"機密 — 許可されたアクセスのみ","Light Mode":"ライトモード","Dark Mode":"ダークモード"},
      ko:{"Sign in":"로그인","Username":"사용자 이름","Password":"비밀번호","Enterprise Security Assessment Platform":"엔터프라이즈 보안 평가 플랫폼","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"기밀 — 승인된 액세스 전용","Light Mode":"라이트 모드","Dark Mode":"다크 모드"},
      zh:{"Sign in":"登录","Username":"用户名","Password":"密码","Enterprise Security Assessment Platform":"企业安全评估平台","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"机密 — 仅限授权访问","Light Mode":"浅色模式","Dark Mode":"深色模式"},
      ar:{"Sign in":"تسجيل الدخول","Username":"اسم المستخدم","Password":"كلمة المرور","Enterprise Security Assessment Platform":"منصة تقييم أمن المؤسسات","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"سري — للوصول المصرح به فقط","Light Mode":"الوضع الفاتح","Dark Mode":"الوضع الداكن"},
      hi:{"Sign in":"साइन इन करें","Username":"उपयोगकर्ता नाम","Password":"पासवर्ड","Enterprise Security Assessment Platform":"एंटरप्राइज़ सुरक्षा मूल्यांकन प्लेटफ़ॉर्म","CONFIDENTIAL — AUTHORIZED ACCESS ONLY":"गोपनीय — केवल अधिकृत पहुँच","Light Mode":"लाइट मोड","Dark Mode":"डार्क मोड"}
    };

    function applyLoginI18n(lang) {
      const L = lang || 'en';
      const d = LOGIN_I18N[L];
      document.documentElement.lang = L;
      document.documentElement.dir = L === 'ar' ? 'rtl' : 'ltr';
      const sel = document.getElementById('langSwitch');
      if (sel) sel.value = L;
      if (!d) return;

      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      const nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      nodes.forEach(n => {
        const k = (n.nodeValue || '').trim();
        if (d[k]) n.nodeValue = n.nodeValue.replace(k, d[k]);
      });
      document.querySelectorAll('[placeholder]').forEach(el => {
        const v = el.getAttribute('placeholder');
        if (v && d[v.trim()]) el.setAttribute('placeholder', d[v.trim()]);
      });
    }

    function switchLang(l) {
      try { localStorage.setItem('ptk-lang', l); } catch(e) {}
      applyLoginI18n(l);
    }

    (function() {
      let L = 'en';
      try { L = localStorage.getItem('ptk-lang') || 'en'; } catch(e) {}
      applyLoginI18n(L);
    })();
  </script>
