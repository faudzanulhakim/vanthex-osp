    /* ==== DARK OPS PASS v1.3.0 — red-team theme (visual only) ==== */
    :root { --accent: #DC2626; --accent2: #EA580C; --accent-glow: rgba(220, 38, 38, 0.38); }
    html[data-theme="dark"] { --bg: #010202; --card: #07090C; --accent: #FF2D40; --accent2: #FF7A18;
      --accent-glow: rgba(255, 45, 64, 0.55); --border: rgba(255, 45, 64, 0.28); }
    body {
      background-image:
        radial-gradient(680px 340px at 10% -8%, rgba(255, 45, 64, 0.17), transparent 62%),
        radial-gradient(820px 420px at 95% 112%, rgba(255, 122, 24, 0.12), transparent 62%),
