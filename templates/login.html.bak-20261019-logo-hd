    /* ==== HUD PASS v1.4.0 — tactical command interface (visual only) ==== */
    .card { position: relative; }
    .card::after { content: ""; position: absolute; inset: 8px; pointer-events: none; opacity: 0.9;
      background:
        linear-gradient(#FF2D40, #FF2D40) left top / 16px 2px,
        linear-gradient(#FF2D40, #FF2D40) left top / 2px 16px,
        linear-gradient(#FF2D40, #FF2D40) right top / 16px 2px,
        linear-gradient(#FF2D40, #FF2D40) right top / 2px 16px,
        linear-gradient(#FF2D40, #FF2D40) left bottom / 16px 2px,
