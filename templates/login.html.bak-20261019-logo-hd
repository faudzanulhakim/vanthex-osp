    .tag-badge { letter-spacing: 1.6px; box-shadow: inset 0 0 0 1px var(--border, #E2E8F0); }
  
    /* ==== CYBER PASS v1.2.0 — security command-center theme (visual only) ==== */
    :root { --accent: #0284C7; --accent2: #2563EB; --accent-glow: rgba(2, 132, 199, 0.40); }
    html[data-theme="dark"] { --bg: #030509; --card: #0A101E; --accent: #22D3EE; --accent2: #3B82F6;
      --accent-glow: rgba(34, 211, 238, 0.50); --border: rgba(56, 189, 248, 0.22); }
    body {
      background-image:
        radial-gradient(680px 340px at 10% -8%, rgba(34, 211, 238, 0.20), transparent 62%),
