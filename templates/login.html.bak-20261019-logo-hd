      background-repeat: no-repeat; }
    .btn.primary, button[type="submit"] { text-transform: uppercase; letter-spacing: 0.1em; }


    /* ==== REFINE PASS v1.5.0 — tidiness & rhythm (visual only) ==== */
    .card { padding: 34px 34px 28px; }
    input { padding: 11px 13px; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .tagline { margin: 14px 0 0; font-size: 12px; letter-spacing: 3px;
      text-transform: uppercase; color: var(--accent); font-weight: 600; }

    /* ==== PREMIUM PASS v1.7.0 — enterprise restraint (visual only) ==== */
