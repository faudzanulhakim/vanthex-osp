.cards > *:nth-child(4), .stats > *:nth-child(4){ animation-delay:.21s }
.cards > *:nth-child(5), .stats > *:nth-child(5){ animation-delay:.27s }
.cards > *:nth-child(6), .stats > *:nth-child(6){ animation-delay:.33s }

/* stat cards: lift + accent sweep on hover */
.stat{ position:relative; overflow:hidden; transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
.stat::before{ content:""; position:absolute; inset:0 0 auto 0; height:2px;
  background:linear-gradient(90deg, var(--vx-accent), var(--vx-accent2), #43B7F5);
  transform:scaleX(0); transform-origin:left; transition:transform .35s ease; }
.stat:hover{ transform:translateY(-3px); box-shadow:0 14px 30px -12px rgba(0,0,0,.55); }
.stat:hover::before{ transform:scaleX(1); }
.card{ transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
.card:hover{ border-color:rgba(255,65,72,.35); }

/* brand: living glow */
.brand-icon{ animation:vxGlow 3.2s ease-in-out infinite; border-radius:10px; }

/* live indicators: real state, animated */
.live-dot{ animation:vxPulseRing 1.8s ease-out infinite; border-radius:50%; }
.live-scan-pill{ background-image:linear-gradient(110deg, rgba(255,65,72,.16) 30%, rgba(255,65,72,.38) 50%, rgba(255,65,72,.16) 70%);
  background-size:400px 100%; animation:vxShimmer 1.4s linear infinite; }

/* buttons & nav: springy micro-interactions */
button, .btn{ transition:transform .16s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease; }
button:hover, .btn:hover{ transform:translateY(-1px); }
button:active, .btn:active{ transform:translateY(0) scale(.98); }
.sidebar a, .side a, nav a{ transition:background .18s ease, color .18s ease, transform .18s ease; }
.sidebar a:hover, .side a:hover, nav a:hover{ transform:translateX(3px); }

/* tables & lists: rows settle in */
tbody tr{ animation:vxFadeIn .4s ease both; }
tbody tr:nth-child(2){ animation-delay:.04s } tbody tr:nth-child(3){ animation-delay:.08s }
tbody tr:nth-child(4){ animation-delay:.12s } tbody tr:nth-child(5){ animation-delay:.16s }
tbody tr:nth-child(6){ animation-delay:.20s } tbody tr:nth-child(7){ animation-delay:.24s }
tbody tr:nth-child(8){ animation-delay:.28s }

/* progress / severity bars grow from the left */
.progress > *, .bar > *, .sevbar > *{ transform-origin:left; animation:vxBarIn .8s cubic-bezier(.22,.8,.32,1) both; }

/* modals & toasts glide */
.modal, .dialog{ animation:vxRise .3s cubic-bezier(.22,.8,.32,1) both; }
.toast{ animation:vxRise .3s cubic-bezier(.22,.8,.32,1) both; }

@media (prefers-reduced-motion: reduce){
  *, *::before, *::after{ animation-duration:.001s !important; animation-iteration-count:1 !important; transition-duration:.001s !important; }
}

/* login backdrop: slow aurora drift in brand colors */
body::before{ content:""; position:fixed; inset:0; z-index:-1;
  background:linear-gradient(120deg, #070B12 0%, #0D1520 30%, rgba(217,39,54,.20) 50%, #0D1520 70%, #070B12 100%);
  background-size:220% 220%; animation:vxDrift 16s ease-in-out infinite; }
</style>
<style>
