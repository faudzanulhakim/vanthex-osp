  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root {
      --bg: #0B1120;
      --bg-gradient: radial-gradient(circle at 50% 0%, rgba(37,99,235,0.15) 0%, rgba(11,17,32,0) 70%), #0B1120;
      --card-bg: rgba(17, 24, 39, 0.85);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
      --fg: #F1F5F9;
      --fg-muted: #94A3B8;
      --accent: #3B82F6;
      --accent-hover: #2563EB;
      --accent-glow: rgba(59, 130, 246, 0.35);
      --input-bg: rgba(15, 23, 42, 0.8);
      --input-border: rgba(255, 255, 255, 0.12);
      --input-focus: #3B82F6;
      --danger: #EF4444;
      --danger-bg: rgba(239, 68, 68, 0.12);
      --danger-border: rgba(239, 68, 68, 0.3);
      --badge-bg: rgba(59, 130, 246, 0.15);
      --badge-border: rgba(59, 130, 246, 0.3);
    }

    html[data-theme="light"] {
      --bg: #F8FAFC;
      --bg-gradient: radial-gradient(circle at 50% 0%, rgba(59,130,246,0.12) 0%, rgba(248,250,252,0) 70%), #F8FAFC;
      --card-bg: rgba(255, 255, 255, 0.95);
      --card-border: rgba(226, 232, 240, 0.9);
      --card-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.08), 0 1px 3px rgba(0,0,0,0.05);
      --fg: #0F172A;
      --fg-muted: #64748B;
      --accent: #2563EB;
      --accent-hover: #1D4ED8;
      --accent-glow: rgba(37, 99, 235, 0.25);
      --input-bg: #FFFFFF;
      --input-border: #CBD5E1;
      --input-focus: #2563EB;
      --danger: #DC2626;
      --danger-bg: #FEF2F2;
      --danger-border: #FCA5A5;
      --badge-bg: rgba(37, 99, 235, 0.08);
      --badge-border: rgba(37, 99, 235, 0.2);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-gradient);
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
      color: var(--fg);
      position: relative;
      overflow-x: hidden;
      padding: 20px;
    }

    /* Ambient cyber grid pattern */
    body::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: 
        radial-gradient(var(--card-border) 1px, transparent 1px);
      background-size: 28px 28px;
      opacity: 0.6;
      pointer-events: none;
      z-index: 0;
    }

    .top-controls {
      position: absolute;
      top: 24px;
      right: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 10;
    }

    .ctrl-btn, .lang-select {
      background: var(--card-bg);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--card-border);
      color: var(--fg-muted);
      border-radius: 20px;
      padding: 7px 14px;
      font-size: 12.5px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
      outline: none;
    }

    .ctrl-btn:hover, .lang-select:hover {
      color: var(--fg);
      border-color: var(--accent);
    }

    .card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 420px;
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 40px 36px 32px;
      box-shadow: var(--card-shadow);
      animation: cardAppear 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes cardAppear {
      from { opacity: 0; transform: translateY(18px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 28px;
    }

    .mark-icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent) 0%, #1E40AF 100%);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px var(--accent-glow);
      margin-bottom: 16px;
      position: relative;
      overflow: hidden;
    }

    .mark-icon::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom right, rgba(255,255,255,0.25), transparent);
      pointer-events: none;
    }

    .mark-icon svg {
      width: 28px;
      height: 28px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    h1 {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--fg);
      margin-bottom: 6px;
    }

    .muted {
      color: var(--fg-muted);
      font-size: 13px;
      line-height: 1.4;
    }

    .tag-badge {
      display: inline-block;
      margin-top: 8px;
      padding: 3px 10px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: var(--badge-bg);
      border: 1px solid var(--badge-border);
      color: var(--accent);
      border-radius: 12px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    label {
      display: block;
      font-size: 11.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--fg-muted);
      margin-bottom: 7px;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon {
      position: absolute;
      left: 14px;
      width: 17px;
      height: 17px;
      color: var(--fg-muted);
      pointer-events: none;
      stroke-width: 2;
    }

    input {
      width: 100%;
      padding: 12px 14px 12px 42px;
      border-radius: 10px;
      border: 1px solid var(--input-border);
      background: var(--input-bg);
      color: var(--fg);
      font-size: 14px;
      outline: none;
      transition: all 0.2s ease;
    }

    input:focus {
      border-color: var(--input-focus);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .toggle-pw {
      position: absolute;
      right: 12px;
      background: transparent;
      border: none;
      color: var(--fg-muted);
      cursor: pointer;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      width: auto;
      margin-top: 0;
    }

    .toggle-pw:hover {
      color: var(--fg);
    }

    .toggle-pw svg {
      width: 17px;
      height: 17px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    button#b {
      width: 100%;
      padding: 13px;
      border: none;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--accent) 0%, #1D4ED8 100%);
      color: #fff;
      font-size: 14.5px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 8px;
      box-shadow: 0 4px 14px var(--accent-glow);
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    button#b:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px var(--accent-glow);
      filter: brightness(1.08);
    }

    button#b:active:not(:disabled) {
      transform: translateY(0);
    }

    button#b:disabled {
      opacity: 0.65;
      cursor: not-allowed;
      transform: none;
    }

    .err {
      color: var(--danger);
      background: var(--danger-bg);
      border: 1px solid var(--danger-border);
      border-radius: 8px;
      font-size: 13px;
      margin-top: 14px;
      padding: 10px 14px;
      display: none;
      align-items: center;
      gap: 8px;
      animation: shake 0.35s ease;
    }

    .err.show {
      display: flex;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-4px); }
      40%, 80% { transform: translateX(4px); }
    }

    .spinner {
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      display: none;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    button#b.loading .spinner {
      display: inline-block;
    }

    .foot {
      margin-top: 26px;
      padding-top: 18px;
      border-top: 1px solid var(--card-border);
      font-size: 10.5px;
      letter-spacing: 0.12em;
      color: var(--danger);
      font-weight: 700;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .foot svg {
      width: 13px;
      height: 13px;
      stroke-width: 2.2;
    }
  
    /* ==== POLISH PASS v1.0.0 — refinement layer (visual only) ==== */
    ::selection { background: var(--accent); color: #fff; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    body { -webkit-font-smoothing: antialiased;
           background-image: radial-gradient(900px 480px at 15% -10%, var(--accent-glow, rgba(37,99,235,0.20)), transparent 60%),
                             radial-gradient(700px 420px at 110% 110%, var(--accent-glow, rgba(37,99,235,0.20)), transparent 55%); }
    .card { box-shadow: 0 24px 48px -16px rgba(2, 6, 23, 0.25), 0 4px 12px -4px rgba(2, 6, 23, 0.12);
            backdrop-filter: saturate(1.2); }
    .input-wrapper input { transition: border-color 0.15s ease, box-shadow 0.15s ease; }
