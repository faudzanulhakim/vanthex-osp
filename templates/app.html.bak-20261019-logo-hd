<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>VANTHEX — Offensive Security Platform</title>
  <meta name="description" content="VANTHEX — Offensive Security Platform. Discover. Validate. Remediate.">
  <meta name="theme-color" content="#010202">
  <link rel="icon" type="image/png" href="data:image/png;base64,">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root {
      --bg: #F8FAFC;
      --bg2: #F1F5F9;
      --card: #FFFFFF;
      --card2: #F8FAFC;
      --fg: #0F172A;
      --fg-muted: #64748B;
      --border: #E2E8F0;
      --border-subtle: #F1F5F9;
      --accent: #2563EB;
      --accent2: #1D4ED8;
      --accent-light: #EFF6FF;
      --accent-glow: rgba(37, 99, 235, 0.2);
      
      --crit: #EF4444;
      --crit-bg: #FEF2F2;
      --high: #F97316;
      --high-bg: #FFF7ED;
      --med: #F59E0B;
      --med-bg: #FFFBEB;
      --low: #0EA5E9;
      --low-bg: #F0F9FF;
      --info: #64748B;
      --info-bg: #F8FAFC;
      --ok: #10B981;
      --ok-bg: #ECFDF5;

      --sidebar-w: 260px;
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --radius-xl: 18px;
    }

    html[data-theme="dark"] {
      --bg: #090D16;
      --bg2: #0F172A;
      --card: #111827;
      --card2: #151F32;
      --fg: #F1F5F9;
      --fg-muted: #94A3B8;
      --border: #1E293B;
      --border-subtle: #162032;
      --accent: #3B82F6;
      --accent2: #60A5FA;
      --accent-light: rgba(59, 130, 246, 0.12);
      --accent-glow: rgba(59, 130, 246, 0.35);

      --crit: #F87171;
      --crit-bg: rgba(239, 68, 68, 0.12);
      --high: #FB923C;
      --high-bg: rgba(249, 115, 22, 0.12);
      --med: #FBBF24;
      --med-bg: rgba(245, 158, 11, 0.12);
      --low: #38BDF8;
      --low-bg: rgba(14, 165, 233, 0.12);
      --info: #94A3B8;
      --info-bg: rgba(148, 163, 184, 0.12);
      --ok: #34D399;
      --ok-bg: rgba(16, 185, 129, 0.12);

      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.4);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -2px rgba(0, 0, 0, 0.3);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -4px rgba(0, 0, 0, 0.3);
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--fg);
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
      display: flex;
      height: 100vh;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--fg-muted); }

    /* ========== SIDEBAR ========== */
    aside {
      width: var(--sidebar-w);
      background: var(--card);
      border-right: 1px solid var(--border);
      padding: 20px 16px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      z-index: 20;
      transition: transform 0.25s ease;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 4px 16px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 16px;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--accent) 0%, #1E40AF 100%);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px var(--accent-glow);
      flex-shrink: 0;
    }

    .brand-icon svg { width: 22px; height: 22px; stroke-width: 2.2; }
    .brand-text h1 { font-size: 15px; font-weight: 700; margin: 0; letter-spacing: -0.01em; color: var(--fg); }
    .brand-text .sub { font-size: 10px; color: var(--fg-muted); letter-spacing: 0.08em; font-weight: 600; text-transform: uppercase; margin-top: 2px; }

    nav { flex: 1; overflow-y: auto; padding-right: 2px; }
    .navsec {
      font-size: 10px;
      color: var(--fg-muted);
      letter-spacing: 0.1em;
      font-weight: 700;
      margin: 16px 10px 6px;
      text-transform: uppercase;
    }

    nav a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 12px;
      border-radius: var(--radius-md);
      color: var(--fg-muted);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 500;
      margin-bottom: 3px;
      cursor: pointer;
      transition: all 0.15s ease;
      user-select: none;
    }

    nav a > * {
      pointer-events: none;
    }

    nav a svg { width: 18px; height: 18px; stroke-width: 2; flex-shrink: 0; }
    nav a:hover { color: var(--fg); background: var(--bg2); }
    nav a.active {
      color: var(--accent);
      background: var(--accent-light);
      font-weight: 600;
    }

    .side-bottom {
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px solid var(--border);
    }

    .theme-switch-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      background: var(--card2);
      color: var(--fg);
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .theme-switch-btn:hover { border-color: var(--accent); color: var(--accent); }

    .userbox {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--card2);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 10px 12px;
      margin-top: 12px;
    }

    .avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent) 0%, #1D4ED8 100%);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 13px;
      box-shadow: 0 2px 6px var(--accent-glow);
      flex-shrink: 0;
    }

    .user-info { overflow: hidden; }
    .user-info .uname { font-size: 13px; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
    .user-info .urole { font-size: 10.5px; color: var(--fg-muted); }

    /* ========== MAIN CONTAINER ========== */
    .app-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
      position: relative;
    }

    /* Top App Bar */
    .topbar {
      height: 56px;
      border-bottom: 1px solid var(--border);
      background: var(--card);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      flex-shrink: 0;
      z-index: 10;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .mobile-menu-toggle {
      display: none;
      background: transparent;
      border: none;
      color: var(--fg);
      cursor: pointer;
      padding: 6px;
      border-radius: var(--radius-sm);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .live-scan-pill {
      display: none;
      align-items: center;
      gap: 8px;
      background: var(--accent-light);
      border: 1px solid var(--accent);
      color: var(--accent);
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11.5px;
      font-weight: 600;
      cursor: pointer;
      animation: pulseGlow 2s infinite;
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 0 0 var(--accent-glow); }
      50% { box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.1); }
    }

    .live-scan-pill.active { display: inline-flex; }
    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      animation: liveBlink 1s infinite alternate;
    }
    @keyframes liveBlink { from { opacity: 0.3; } to { opacity: 1; } }

    .lang-pill-select {
      background: var(--card2);
      border: 1px solid var(--border);
      color: var(--fg);
      padding: 5px 10px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      outline: none;
      cursor: pointer;
    }

    main {
      flex: 1;
      padding: 24px 28px 40px;
      overflow-y: auto;
      max-width: 1300px;
      width: 100%;
      margin: 0 auto;
    }

    /* Page Header */
    .pagehead {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 22px;
      flex-wrap: wrap;
      gap: 14px;
    }

    .pagehead h2 {
      margin: 0;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--fg);
    }

    .pagehead .crumb {
      font-size: 12px;
      color: var(--fg-muted);
      margin-top: 3px;
    }

    /* Buttons */
    .btn {
      padding: 8px 16px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--fg);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      line-height: 1.4;
    }

    .btn:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }

    .btn.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      box-shadow: 0 2px 8px var(--accent-glow);
    }

    .btn.primary:hover {
      background: var(--accent2);
      border-color: var(--accent2);
      color: #fff;
    }

    .btn.primary:disabled { opacity: 0.55; cursor: wait; transform: none; }
    .btn.danger { color: var(--crit); border-color: rgba(239, 68, 68, 0.3); background: var(--crit-bg); }
    .btn.danger:hover { background: var(--crit); color: #fff; border-color: var(--crit); }

    /* Stat Cards */
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .stat {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px 20px;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .stat:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--accent);
    }

    .stat::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: var(--accent);
    }

    .stat.red::before { background: var(--crit); }
    .stat.green::before { background: var(--ok); }
    .stat.amber::before { background: var(--med); }

    .stat .n {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--fg);
      line-height: 1.1;
    }

    .stat .l {
      font-size: 11px;
      color: var(--fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
      margin-top: 6px;
    }

    .stat .ic {
      position: absolute;
      right: 16px;
      top: 18px;
      font-size: 16px;
      opacity: 0.85;
    }

    /* Panels */
    .panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 22px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-sm);
    }

    .panel h3 {
      margin: 0 0 16px;
      font-size: 15px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--fg);
      letter-spacing: -0.01em;
    }

    /* Tables */
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    td, th { padding: 11px 14px; border-bottom: 1px solid var(--border); text-align: left; }
    th {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--fg-muted);
      font-weight: 600;
      background: var(--card2);
    }
    th:first-child { border-top-left-radius: var(--radius-sm); }
    th:last-child { border-top-right-radius: var(--radius-sm); }
    tr:last-child td { border-bottom: 0; }
    tbody tr { transition: background 0.1s ease; }
    tbody tr:hover { background: var(--bg2); }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: #fff;
      line-height: 1.3;
    }

    .b-CRITICAL { background: var(--crit); }
    .b-HIGH { background: var(--high); }
    .b-MEDIUM { background: var(--med); }
    .b-LOW { background: var(--low); }
    .b-INFO { background: var(--info); }
    .b-CLEAN { background: var(--ok); }
    .b-- { background: #718096; }
    .b-passive { background: #475569; }
    .b-active { background: var(--accent); }
    .b-confirmed { background: var(--ok); }
    .b-probable { background: var(--med); }
    .b-candidate { background: #64748B; }

    /* Forms */
    select, input[type=text], input[type=date], input[type=number], input[type=password], textarea {
      padding: 10px 14px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--fg);
      font-size: 13.5px;
      outline: none;
      transition: all 0.15s ease;
      font-family: inherit;
    }

    select:focus, input[type=text]:focus, input[type=date]:focus, input[type=number]:focus, input[type=password]:focus, textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    input[type=text] { width: 100%; margin: 6px 0 14px; }
    textarea { width: 100%; margin: 6px 0 14px; font-family: 'Cascadia Code', Consolas, monospace; font-size: 12px; resize: vertical; }
    label.fl { font-size: 11px; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; display: block; margin-top: 6px; }

    /* Segment Selectors */
    .seg { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 8px 0 16px; }
    .seg label {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 14px;
      cursor: pointer;
      background: var(--card);
      transition: all 0.15s;
      display: block;
    }
    .seg input { display: none; }
    .seg label:has(input:checked) {
      border-color: var(--accent);
      background: var(--accent-light);
      box-shadow: 0 0 0 1px var(--accent);
    }
    .seg .t { font-weight: 700; font-size: 13.5px; display: flex; gap: 8px; align-items: center; color: var(--fg); }
    .seg .d { font-size: 12px; color: var(--fg-muted); margin-top: 6px; line-height: 1.5; }

    .toolseg { display: flex; gap: 8px; flex-wrap: wrap; margin: 6px 0 16px; }
    .toolseg button {
      padding: 8px 14px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--fg-muted);
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      transition: all 0.15s ease;
    }
    .toolseg button:hover { border-color: var(--accent); color: var(--fg); }
    .toolseg button.on { color: #fff; background: var(--accent); border-color: var(--accent); box-shadow: 0 2px 8px var(--accent-glow); }

    /* Findings Cards */
    .finding {
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent);
      padding: 16px 18px;
      margin-bottom: 14px;
      background: var(--card);
      border-radius: 4px var(--radius-md) var(--radius-md) 4px;
      box-shadow: var(--shadow-sm);
      transition: all 0.15s ease;
    }

    .finding:hover { box-shadow: var(--shadow-md); transform: translateX(2px); }
    .finding .row1 { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .finding .cvss { margin-left: auto; font-weight: 800; font-size: 13px; }
    .finding .d { color: var(--fg-muted); font-size: 13px; margin-top: 8px; line-height: 1.6; }
    .finding .ev {
      font-family: 'Cascadia Code', Consolas, monospace;
      font-size: 11.5px;
      color: var(--fg);
      margin-top: 8px;
      word-break: break-all;
      background: var(--card2);
      border-left: 3px solid var(--accent);
      padding: 8px 12px;
      border-radius: var(--radius-sm);
    }
    .finding .meta { font-size: 11.5px; margin-top: 8px; color: var(--fg-muted); }
    .finding .meta b { color: var(--fg); }
    .fix {
      margin-top: 10px;
      font-size: 12.5px;
      background: var(--ok-bg);
      border: 1px solid rgba(16, 185, 129, 0.25);
      border-radius: var(--radius-md);
      padding: 9px 14px;
      color: var(--ok);
    }

    /* Terminal */
    .term-container {
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-top: 14px;
      box-shadow: var(--shadow-md);
      background: #0B1120;
    }

    .term-head {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #0F172A;
      color: #94A3B8;
      padding: 10px 14px;
      font-family: 'Cascadia Code', Consolas, monospace;
      font-size: 11.5px;
      border-bottom: 1px solid #1E293B;
    }
    .tdot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
    .tbtn {
      background: #1E293B;
      color: #E2E8F0;
      border: 1px solid #334155;
      border-radius: var(--radius-sm);
      font-size: 11px;
      padding: 4px 10px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .tbtn:hover { background: #334155; color: #fff; }

    .term {
      margin: 0;
      padding: 16px;
      background: #090D16;
      color: #E2E8F0;
      font-family: 'Cascadia Code', Consolas, monospace;
      font-size: 12px;
      line-height: 1.7;
      max-height: 380px;
      overflow-y: auto;
      white-space: pre-wrap;
    }

    .term-prog { height: 4px; background: #1E293B; }
    .term-prog div { height: 100%; width: 0; background: var(--ok); transition: width 0.35s ease; }

    .authbox {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      background: var(--med-bg);
      border: 1px solid rgba(245, 158, 11, 0.35);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      margin: 6px 0 16px;
      font-size: 13px;
      line-height: 1.55;
      color: #92400E;
    }
    html[data-theme="dark"] .authbox { color: #FCD34D; }

    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 768px) {
      aside { position: fixed; left: -280px; height: 100vh; }
      aside.open { transform: translateX(280px); }
      .mobile-menu-toggle { display: block; }
      .grid2 { grid-template-columns: 1fr; }
      main { padding: 16px; }
    }

    /* Toast Notification System */
    #toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 9999;
      pointer-events: none;
    }

    .toast {
      pointer-events: auto;
      min-width: 280px;
      max-width: 420px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 12px 16px;
      box-shadow: var(--shadow-lg);
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      animation: toastIn 0.25s ease;
      color: var(--fg);
    }

    @keyframes toastIn { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .toast.success { border-left: 4px solid var(--ok); }
    .toast.error { border-left: 4px solid var(--crit); }
    .toast.warning { border-left: 4px solid var(--med); }
    .toast.info { border-left: 4px solid var(--accent); }

    /* Modal System */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9990;
      animation: fadeIn 0.15s ease;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 460px;
      padding: 24px;
