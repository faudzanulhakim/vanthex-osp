function renderTargetTrend() {
  const sel = document.getElementById('trendTarget'); if (!sel) return;
  const pts = ((window._ins || {}).trend_by_target || {})[sel.value] || [];
  const box = document.getElementById('trendChart'); if (!box) return;
  if (pts.length < 1) { box.innerHTML = '<div class="empty">—</div>'; return; }
  const W = 320, H = 100, pad = 12;
  const xs = i => pad + i * (W - 2 * pad) / Math.max(1, pts.length - 1);
  const ys = v => H - pad - ((v ?? 0) / 100) * (H - 2 * pad - 12);
  const line = pts.map((p, i) => `${xs(i)},${ys(p.score)}`).join(' ');
  box.innerHTML = `
    <svg width="100%" height="${H}" viewBox="0 0 ${W} ${H}">
      <polyline points="${line}" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round"/>
      ${pts.map((p, i) => `<circle cx="${xs(i)}" cy="${ys(p.score)}" r="4" fill="${(p.score ?? 0) >= 70 ? 'var(--crit)' : (p.score ?? 0) >= 40 ? 'var(--med)' : 'var(--ok)'}">
        <title>${new Date(p.t * 1000).toLocaleString('en-GB')} — score ${p.score ?? '-'} (${esc(p.risk || '')})</title>
      </circle>`).join('')}
      ${pts.map((p, i) => `<text x="${xs(i)}" y="${H - 2}" text-anchor="middle" font-size="8" fill="var(--fg-muted)">${p.score ?? '-'}</text>`).join('')}
    </svg>`;
}

