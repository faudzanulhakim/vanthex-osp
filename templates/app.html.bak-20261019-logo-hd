function curLang() {
  try { return localStorage.getItem('ptk-lang') || 'en'; } catch(e) { return 'en'; }
}

function tr(s) {
  const L = curLang();
  if (L === 'en') return s;
  const d = I18N[L];
  return (d && d[s]) || s;
}

function applyI18n() {
  const L = curLang();
  document.documentElement.lang = L;
  document.documentElement.dir = (L === 'ar') ? 'rtl' : 'ltr';
  const d = I18N[L];
  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
    acceptNode: function(n) {
      if (!n.nodeValue || !n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
      const p = n.parentElement;
      if (!p) return NodeFilter.FILTER_REJECT;
      const t = p.tagName;
      if (t === 'SCRIPT' || t === 'STYLE' || t === 'PRE' || t === 'CODE' || t === 'TEXTAREA') return NodeFilter.FILTER_REJECT;
      if (p.closest('pre, code, .term')) return NodeFilter.FILTER_REJECT;
      return NodeFilter.FILTER_ACCEPT;
    }
  });

  const nodes = [];
  while (walker.nextNode()) nodes.push(walker.currentNode);
  for (let i = 0; i < nodes.length; i++) {
    const n = nodes[i];
    if (n.__orig === undefined) n.__orig = n.nodeValue;
    const orig = n.__orig, key = orig.trim();
    const rep = (L === 'en' || !d) ? null : d[key];
    const target = rep ? orig.replace(key, rep) : orig;
    if (n.nodeValue !== target) n.nodeValue = target;
  }

  document.querySelectorAll('[placeholder],[title]').forEach(function(el) {
    ['placeholder', 'title'].forEach(function(at) {
      const v = el.getAttribute(at);
      if (v === null) return;
      const k = '__o_' + at;
      if (el.dataset[k] === undefined) el.dataset[k] = v;
      const o = el.dataset[k];
      const rep = (L === 'en' || !d) ? null : d[o.trim()];
      const target = rep ? o.replace(o.trim(), rep) : o;
      if (v !== target) el.setAttribute(at, target);
    });
  });
}

function setLang(l) {
  try { localStorage.setItem('ptk-lang', l); } catch(e) {}
  applyI18n();
}

let __cf = window.confirm, __al = window.alert;
window.confirm = function(m) { return __cf(tr(String(m))); };
window.alert = function(m) { showToast(tr(String(m)), 'info'); };

let __i18nBusy = false;
new MutationObserver(function() {
  if (__i18nBusy) return;
  __i18nBusy = true;
  requestAnimationFrame(function() {
    applyI18n();
    __i18nBusy = false;
  });
}).observe(document.body, { childList: true, subtree: true, characterData: true });

applyI18n();

