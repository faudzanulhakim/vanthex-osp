  document.getElementById('bulkTargets').style.display = on ? 'block' : 'none';
  document.getElementById('target').style.display = on ? 'none' : 'block';
}

async function runBulk() {
  const btn = document.getElementById('run');
  const prog = document.getElementById('progress');
  const list = document.getElementById('bulkTargets').value.split(/\n+/).map(s => s.trim()).filter(Boolean).slice(0, 20);

  if (!list.length) { showToast('Fill in the bulk target list first', 'warning'); return; }

  const profile = document.getElementById('profile').value;
  const body0 = { type: 'vulnscan', profile };
  const ck = document.getElementById('opt-cookie').value.trim(); if (ck) body0.cookie = ck;

  if (!profile.startsWith('passive')) {
    if (!document.getElementById('authorized')?.checked) {
      showToast('Check the authorization statement first for an active scan.', 'error');
      return;
    }
    body0.authorized = true;
  }

  btn.disabled = true;
  document.getElementById('liveScanIndicator').classList.add('active');
  prog.innerHTML = `<div class="panel" style="margin-top:14px"><h3>📦 Bulk Scan — ${list.length} targets</h3><div id="bulkrows"></div></div>`;
  const rows = document.getElementById('bulkrows');

  for (const tg of list) {
    const row = document.createElement('div');
    row.style.cssText = 'padding:9px 0;border-bottom:1px solid var(--border);font-size:13px;display:flex;align-items:center;gap:8px';
    row.innerHTML = '⏳ <b>' + esc(tg) + '</b> — queued…';
    rows.appendChild(row);

    try {
      row.innerHTML = '⚡ <b>' + esc(tg) + '</b> — scanning…';
      const { job_id } = await $('/api/scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...body0, target: tg })
      });

      while (true) {
        await new Promise(r => setTimeout(r, 1500));
        const j = await $('/api/job/' + job_id);
        if (j.status === 'done') {
          row.innerHTML = `✓ <a onclick="viewScanDetail('${j.result.scan_id}')" style="cursor:pointer;font-weight:600;color:var(--accent)">${esc(tg)}</a> — ${badge(j.result.overall_risk)} · score ${j.result.risk_score ?? '-'} · ${j.result.findings.length} findings`;
          break;
        }
        if (j.status !== 'running') {
          row.innerHTML = '⏹ <b>' + esc(tg) + '</b> — ' + j.status;
          break;
        }
      }
    } catch(e) {
      row.innerHTML = '⚠️ <b>' + esc(tg) + '</b> — ' + esc(String(e));
    }
  }

  document.getElementById('liveScanIndicator').classList.remove('active');
