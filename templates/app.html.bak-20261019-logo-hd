async function runMobileAnalyze() {
  const inp = document.getElementById('apkfile');
  const prog = document.getElementById('mprogress');
  const btn = document.getElementById('apkbtn');

  if (!inp.files.length) { showToast('Choose an APK/IPA file first', 'warning'); return; }
  const file = inp.files[0];
  if (file.size > 60 * 1024 * 1024) { showToast('Package too large (max 60 MB)', 'error'); return; }

  btn.disabled = true;
  prog.innerHTML = `
    <div style="font-size:13px;color:var(--fg-muted)">⏳ Uploading & analyzing ${esc(file.name)}…</div>
    <div class="term-container">
      <div class="term-head">
        <span class="tdot" style="background:#F87171"></span>
        <span class="tdot" style="background:#FBBF24"></span>
        <span class="tdot" style="background:#4ADE80"></span>
        <span style="margin-left:8px">root@pentest-toolkit: ~/mobile-analysis</span>
      </div>
      <pre id="mlog" class="term" style="max-height:260px">uploading…</pre>
    </div>`;

  try {
    const b64 = await new Promise((res, rej) => {
      const r = new FileReader();
      r.onload = () => res(String(r.result).split(',', 2)[1]);
      r.onerror = rej;
      r.readAsDataURL(file);
    });

    const { job_id } = await $('/api/mobile/analyze', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ filename: file.name, data_base64: b64 })
    });

    let seen = 0;
    while (true) {
      await new Promise(r => setTimeout(r, 900));
      const j = await $('/api/job/' + job_id);
      const logEl = document.getElementById('mlog');
      if (logEl && j.log.length > seen) {
        logEl.innerHTML = colorizeLog(j.log);
        logEl.scrollTop = logEl.scrollHeight;
        seen = j.log.length;
      }
      if (j.status === 'done') {
        prog.innerHTML = `<div style="font-size:13px;color:var(--ok)">✓ Analysis completed in ${j.elapsed} sec</div>`;
        renderMobileResult(j.result);
        loadMobileHist();
        break;
      }
      if (j.status === 'error') {
        prog.innerHTML = `<div class="empty" style="color:var(--crit)">Analysis failed: ${esc(j.result?.error || 'unknown')}</div>`;
        break;
      }
    }
  } catch(e) {
    prog.innerHTML = `<div class="empty" style="color:var(--crit)">Error: ${esc(String(e))}</div>`;
  }
  btn.disabled = false;
}

