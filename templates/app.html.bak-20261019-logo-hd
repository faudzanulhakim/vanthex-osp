async function rescan(id, ev) {
  if (ev) ev.stopPropagation();
  const s = HIST_CACHE.find(x => x.id === id); if (!s) return;
  const body = { type: s.scan_type || 'vulnscan', target: s.target, profile: s.profile };

  if (!(s.profile || '').startsWith('passive') || s.scan_type !== 'vulnscan') {
    const ok = await confirmDialog('Active Rescan Confirmation', `Rescanning "${s.target}" is an ACTIVE scan. Proceed only if the authorization is still valid.`);
    if (!ok) return;
    body.authorized = true;
  }

  try {
    const { job_id } = await $('/api/scan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    showToast(`Rescan started for ${s.target}`, 'info');
    while (true) {
      await new Promise(r => setTimeout(r, 2000));
      const j = await $('/api/job/' + job_id);
      if (j.status === 'done' || j.status === 'error' || j.status === 'cancelled') {
        viewHist();
        break;
      }
    }
  } catch(e) {
    showToast('Failed to start rescan: ' + e, 'error');
  }
}

function colorizeLog(lines) {
  const sev = { CRITICAL: '#F87171', HIGH: '#FB923C', MEDIUM: '#FBBF24', LOW: '#38BDF8', INFO: '#94A3B8' };
  return lines.map(l => {
    const e = esc(l);
    if (/ERROR|GAGAL|Traceback|Exception/.test(l)) return '<span style="color:#F87171">' + e + '</span>';
    const m = l.match(/\[(CRITICAL|HIGH|MEDIUM|LOW|INFO)\//);
    if (m) return '<span style="color:' + sev[m[1]] + ';font-weight:700">' + e + '</span>';
    if (/^\[(run|crawl|done|verify|portscan)\]/.test(l) || /^\[\d+\/\d+\]/.test(l) || /^\s*\[tech/.test(l))
      return '<span style="color:#7DD3FC">' + e + '</span>';
    if (/TERKONFIRMASI|terkonfirmasi/.test(l)) return '<span style="color:#4ADE80;font-weight:700">' + e + '</span>';
    if (/^\s+\[/.test(l)) return '<span style="color:#94A3B8">' + e + '</span>';
    return e;
  }).join('\n');
}

