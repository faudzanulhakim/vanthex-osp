    <div class="panel">
      <div class="grid2" style="margin-bottom:12px">
        <input type="text" id="hsearch" placeholder="🔍 Search target…" style="margin:0">
        <select id="hrisk" style="margin:0">
          <option value="">All risks</option>
          <option>CRITICAL</option><option>HIGH</option><option>MEDIUM</option><option>LOW</option><option>CLEAN</option>
        </select>
      </div>
      <div id="htable"></div>
    </div>`;

  const draw = () => {
    const q = document.getElementById('hsearch').value.toLowerCase();
    const rk = document.getElementById('hrisk').value;
    const rows = HIST_CACHE.filter(s => (!q || s.target.toLowerCase().includes(q)) && (!rk || s.overall_risk === rk)).map(s => `
      <tr>
        <td>
          <a onclick="viewScanDetail('${s.id}')" style="cursor:pointer;font-weight:600;color:var(--accent)">${esc(s.target)}</a>
          <div style="font-size:11px;color:var(--fg-muted)">${esc(s.scan_type || 'vulnscan')}</div>
        </td>
        <td>${badge(s.overall_risk)}</td>
        <td><span class="badge b-${s.profile && s.profile.startsWith('passive') ? 'passive' : 'active'}">${s.profile || 'deep'}</span></td>
        <td style="color:var(--fg-muted)">${new Date(s.started_at * 1000).toLocaleString('en-GB')}</td>
        <td>
          <a class="btn" style="padding:3px 8px;font-size:11px" href="/report/${s.id}?fmt=docx" title="Export DOCX">DOCX</a>
          <a class="btn" style="padding:3px 8px;font-size:11px" href="/report/${s.id}" target="_blank" title="HTML">HTML</a>
          ${s.scan_type === 'mobile' ? '' : `<a class="btn" style="padding:3px 8px;font-size:11px" onclick="rescan('${s.id}', event)">⚡ Rescan</a>`}
          <a class="btn danger" style="padding:3px 8px;font-size:11px" onclick="delScan('${s.id}', '${esc(s.target).replace(/'/g, "\\'")}', event)">Delete</a>
        </td>
      </tr>
    `).join('');

    document.getElementById('htable').innerHTML = `
      <table>
        <tr><th>Target</th><th>Risk</th><th>Profile</th><th>Time</th><th>Actions</th></tr>
        ${rows || '<tr><td colspan=5 class="empty">No matching scans</td></tr>'}
      </table>`;
  };

  document.getElementById('hsearch').oninput = draw;
  document.getElementById('hrisk').onchange = draw;
  draw();
}

async function viewScanDetail(id) {
  const d = await $('/api/scan/' + id);
  document.getElementById('main').innerHTML = head('Scan Detail', esc(d.scan.target)) + '<div id="mmeta"></div><div id="reswrap"></div><div id="diffwrap"></div>';

  if (d.scan.scan_type === 'mobile') {
    if (d.tool_result) renderMobileMeta(d.tool_result);
    renderFindings({
      findings: d.findings,
      summary: d.scan.summary,
      overall_risk: d.scan.overall_risk,
      risk_score: d.risk_score,
      summary_by_confidence: d.summary_by_confidence || {},
      errors: [],
      duration_s: d.duration_s,
      profile: d.scan.profile
    }, 'Detail — ' + esc(d.scan.target), `
      <a class="btn" href="/report/${id}?fmt=docx">📄 DOCX</a>
      <a class="btn" href="/report/${id}" target="_blank">🌐 HTML</a>
      <a class="btn" href="/api/scan/${id}/export?fmt=json">💾 JSON</a>
      <a class="btn danger" onclick="delScan('${id}','${esc(d.scan.target).replace(/'/g, "\\'")}', event)">Delete</a>`);
    return;
  }

  if (d.scan.scan_type && d.scan.scan_type !== 'vulnscan') {
    renderToolResult(d.tool_result || {}, `Results — ${esc(d.scan.target)}`);
    return;
  }

  renderFindings({
    findings: d.findings,
    summary: d.scan.summary,
    overall_risk: d.scan.overall_risk,
    risk_score: d.risk_score,
    method: (d.scan.profile || '').startsWith('passive') ? 'passive' : 'active',
    technologies: d.technologies || [],
    tech_profile: d.tech_profile || [],
    summary_by_confidence: d.summary_by_confidence || {},
    duration_s: d.duration_s,
    profile: d.scan.profile,
    checks_run: (d.engine || {}).checks_run,
    checks_total: (d.engine || {}).checks_total,
    checks_detail: (d.engine || {}).checks_detail || [],
    http_stats: (d.engine || {}).http_stats || {},
    errors: (d.engine || {}).errors || []
  }, `Detail — ${esc(d.scan.target)}`, `
    <a class="btn" href="/report/${id}?fmt=docx">📄 DOCX</a>
    <a class="btn" href="/report/${id}" target="_blank">🌐 HTML</a>
    <a class="btn" href="/api/scan/${id}/export?fmt=json">💾 JSON</a>
    <a class="btn" href="/api/scan/${id}/export?fmt=csv">📊 CSV</a>
    <a class="btn" onclick="loadDiff('${id}')">🔍 Diff vs previous</a>
    <a class="btn danger" onclick="delScan('${id}','${esc(d.scan.target).replace(/'/g, "\\'")}', event)">Delete</a>`);
}

async function loadDiff(id) {
  try {
    const d = await $('/api/scan/' + id + '/diff');
    document.getElementById('diffwrap').innerHTML = `
      <div class="panel">
        <h3>🔍 Diff vs Previous Scan</h3>
        ${d.previous_scan_id ? `
          <div style="font-size:13px;line-height:1.9">
            <b>New (${d.new.length}):</b> ${d.new.map(esc).join('; ') || '—'}<br>
            <b>Resolved (${d.resolved.length}):</b> ${d.resolved.map(esc).join('; ') || '—'}<br>
            <b>Unchanged:</b> ${d.unchanged} findings
          </div>` : '<div class="empty">No baseline scan found for this target+profile.</div>'}
      </div>`;
  } catch(e) {
    showToast('Diff failed: ' + e, 'error');
  }
}

const views = {
  dash: ['nav-dash', viewDash],
  scan: ['nav-scan', viewScan],
  hist: ['nav-hist', viewHist],
  findings: ['nav-findings', viewFindings],
  assets: ['nav-assets', viewAssets],
  sched: ['nav-sched', viewSchedules],
  audit: ['nav-audit', viewAudit],
  users: ['nav-users', viewUsers],
  mobile: ['nav-mobile', viewMobile]
};

function show(v) {
  Object.values(views).forEach(([id]) => document.getElementById(id).classList.remove('active'));
  document.getElementById(views[v][0]).classList.add('active');
  views[v][1]();
  if (window.innerWidth <= 768) document.getElementById('sidebar').classList.remove('open');
}

document.getElementById('nav-dash').onclick = () => show('dash');
document.getElementById('nav-scan').onclick = () => show('scan');
document.getElementById('nav-mobile').onclick = () => show('mobile');
document.getElementById('nav-hist').onclick = () => show('hist');
document.getElementById('nav-findings').onclick = () => show('findings');
document.getElementById('nav-assets').onclick = () => show('assets');
document.getElementById('nav-sched').onclick = () => show('sched');
document.getElementById('nav-audit').onclick = () => show('audit');
document.getElementById('nav-users').onclick = () => show('users');
document.getElementById('nav-logout').onclick = async () => {
  await fetch('/api/logout', { method: 'POST' });
  location.href = '/login';
};

(async () => {
  try {
    const me = await $('/api/me');
    document.getElementById('uname').textContent = me.user;
    document.getElementById('urole').textContent = me.role.toUpperCase();
    document.getElementById('uav').textContent = me.user[0].toUpperCase();
  } catch(e) {}
  show('dash');
})();

// Apply initial translation and observe dynamic changes
applyI18n();
</script>

<script>
/* ============ INTERACTIVE PASS v1.13.0 (service UI) ============
   Safe, self-contained interaction layer: stat-card tilt + Ctrl+K
   search focus. Touches no data, no API, no existing handlers. */
(function(){
  try{
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.addEventListener("keydown", function(e){
      var tag = (e.target && e.target.tagName) || "";
      var typing = tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || (e.target && e.target.isContentEditable);
      if ((e.ctrlKey || e.metaKey) && (e.key === "k" || e.key === "K")){
        var s = document.getElementById("hsearch");
        if (s){ e.preventDefault(); s.focus(); s.select && s.select(); }
      } else if (e.key === "/" && !typing){
        var s2 = document.getElementById("hsearch");
        if (s2){ e.preventDefault(); s2.focus(); }
      } else if (e.key === "Escape" && document.activeElement){
        document.activeElement.blur();
      }
    });
    if (!reduce){
      document.addEventListener("mousemove", function(e){
        var el = e.target && e.target.closest ? e.target.closest(".stat") : null;
        document.querySelectorAll(".stat.vx-tilt").forEach(function(n){
          if (n !== el){ n.classList.remove("vx-tilt"); n.style.removeProperty("--vx-rx"); n.style.removeProperty("--vx-ry"); }
        });
        if (!el) return;
        var r = el.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width - .5;
        var py = (e.clientY - r.top) / r.height - .5;
        el.classList.add("vx-tilt");
        el.style.setProperty("--vx-ry", (px * 7).toFixed(2) + "deg");
        el.style.setProperty("--vx-rx", (-py * 7).toFixed(2) + "deg");
      });
    }
  }catch(err){ /* interaksi tidak boleh menjatuhkan aplikasi */ }
})();
</script>
<style>
.stat.vx-tilt{ transform:perspective(700px) rotateX(var(--vx-rx,0deg)) rotateY(var(--vx-ry,0deg)) translateY(-3px); }
</style>
</body>
