async function runScan() {
  if (STYPE === 'vulnscan' && document.getElementById('bulkToggle')?.checked) return runBulk();
  const btn = document.getElementById('run');
  const target = document.getElementById('target').value.trim();
  const prog = document.getElementById('progress');

  if (!target) { showToast('Enter a target first', 'warning'); return; }

  const body = { type: STYPE, target };
  if (STYPE === 'vulnscan') {
    body.profile = document.getElementById('profile').value;
    const ck = document.getElementById('opt-cookie').value.trim(); if (ck) body.cookie = ck;
    const hd = document.getElementById('opt-headers').value.trim();
    if (hd) {
      try { body.headers = JSON.parse(hd); }
      catch(e) { showToast('Extra headers are not valid JSON', 'error'); return; }
    }
    const to = document.getElementById('opt-timeout').value.trim(); if (to) body.timeout = parseFloat(to);
    const pg = document.getElementById('opt-pages').value.trim(); if (pg) body.max_pages = parseInt(pg);
    const px = document.getElementById('opt-proxy').value.trim(); if (px) body.proxy = px;
  }

  if (STYPE === 'vulnscan' || STYPE === 'hybrid') {
    const sid = document.getElementById('secretSel').value; if (sid) body.secret_id = parseInt(sid);
    const sid2 = document.getElementById('secretSel2').value; if (sid2) body.secret_id2 = parseInt(sid2);
    if (document.getElementById('opt-headless')?.checked) body.headless = true;
  } else if (STYPE === 'ports') {
    body.ports = document.getElementById('ports').value.trim();
  } else if (STYPE === 'subdomains') {
    const s = document.getElementById('subs').value.trim(); if (s) body.subs = s.split(/\s+/);
  } else if (STYPE === 'dirs') {
    const s = document.getElementById('words').value.trim(); if (s) body.words = s.split(/\s+/);
  }

  const needAuth = STYPE !== 'vulnscan' || !(body.profile || '').startsWith('passive');
  if (needAuth) {
    if (!document.getElementById('authorized')?.checked) {
      showToast('Check the authorization statement first for an active scan.', 'error');
      return;
    }
    body.authorized = true;
  }

  btn.disabled = true;
  document.getElementById('liveScanIndicator').classList.add('active');

  prog.innerHTML = `
    <div class="pbar"><div></div></div>
    <div style="font-size:13px;color:var(--fg-muted);display:flex;align-items:center;justify-content:space-between">
      <span>⏳ Scan <b style="color:var(--fg)">${esc(STYPE)}</b> running against <b style="color:var(--fg)">${esc(target)}</b>…</span>
      <button class="btn danger" id="stopbtn" style="padding:4px 12px;font-size:11.5px">⏹ Stop Scan</button>
    </div>
    <div class="term-container" id="termWrap">
      <div class="term-head">
        <span class="tdot" style="background:#F87171"></span>
        <span class="tdot" style="background:#FBBF24"></span>
        <span class="tdot" style="background:#4ADE80"></span>
        <span style="margin-left:8px">root@pentest-toolkit: ~/live-log — ${esc(target)}</span>
        <span style="margin-left:auto;display:flex;gap:6px">
          <button class="tbtn" id="logpause">Pause</button>
          <button class="tbtn" id="logcopy">Copy</button>
          <button class="tbtn" id="logfull">Full</button>
        </span>
      </div>
      <div class="term-prog"><div id="scanprog"></div></div>
      <pre id="scanlog" class="term">memulai engine…</pre>
    </div>`;

  try {
    const { job_id } = await $('/api/scan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });

    CURRENT_JOB = job_id;
    window._logPaused = false;
    window._lastLog = [];

    const _pb = document.getElementById('logpause');
    if (_pb) _pb.onclick = () => {
      window._logPaused = !window._logPaused;
      _pb.textContent = window._logPaused ? 'Resume' : 'Pause';
      if (!window._logPaused) {
        const le = document.getElementById('scanlog');
        if (le && window._lastLog) { le.innerHTML = colorizeLog(window._lastLog); le.scrollTop = le.scrollHeight; }
      }
    };

    const _cb = document.getElementById('logcopy');
    if (_cb) _cb.onclick = () => {
      if (navigator.clipboard && window._lastLog) {
        navigator.clipboard.writeText(window._lastLog.join('\n'));
        showToast('Log copied to clipboard', 'success');
      }
    };

    const _fb = document.getElementById('logfull');
    if (_fb) _fb.onclick = () => {
      const le = document.getElementById('scanlog');
      if (le) {
        if (le.style.maxHeight === '85vh') {
          le.style.maxHeight = '380px';
          _fb.textContent = 'Full';
        } else {
          le.style.maxHeight = '85vh';
          _fb.textContent = 'Restore';
        }
      }
    };

    const stop = document.getElementById('stopbtn');
    if (stop) stop.onclick = async () => {
      await fetch('/api/job/' + job_id + '/cancel', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}'
      });
      stop.textContent = '⏹ Stopping…';
      stop.disabled = true;
    };

    let seen = 0, delay = 700;
    while (true) {
      await new Promise(r => setTimeout(r, delay));
      const j = await $('/api/job/' + job_id);
      delay = (j.log.length > seen) ? 700 : Math.min(4000, Math.round(delay * 1.4));
      const logEl = document.getElementById('scanlog');
      if (logEl && j.log.length > seen) {
        seen = j.log.length;
        window._lastLog = j.log;
        if (!window._logPaused) {
          logEl.innerHTML = colorizeLog(j.log);
          logEl.scrollTop = logEl.scrollHeight;
        }
        const pm = [...j.log].reverse().map(l => l.match(/\[(\d+)\/(\d+)\]/)).find(Boolean);
        const bar = document.getElementById('scanprog');
        if (bar && pm) bar.style.width = Math.round(100 * pm[1] / pm[2]) + '%';
      }

      if (j.status === 'done' || j.status === 'cancelled') {
        document.getElementById('liveScanIndicator').classList.remove('active');
        prog.innerHTML = `
          <div style="font-size:13px;margin-top:10px;color:${j.status === 'done' ? 'var(--ok)' : 'var(--med)'}">
            ${j.status === 'done' ? '✓' : '⏹'} Scan ${j.status === 'done' ? 'completed' : 'cancelled'} in <b>${j.elapsed} sec</b>
          </div>`;

        if (j.result && j.result.type === 'vulnscan') {
          renderFindings(j.result, `Results — ${esc(target)}`, `
            <a class="btn" href="/report/${j.result.scan_id}?fmt=docx">📄 DOCX</a>
            <a class="btn" href="/report/${j.result.scan_id}" target="_blank">🌐 HTML</a>
            <a class="btn" href="/api/scan/${j.result.scan_id}/export?fmt=json">💾 JSON</a>
            <a class="btn" href="/api/scan/${j.result.scan_id}/export?fmt=csv">📊 CSV</a>`);
        } else if (j.result) {
          renderToolResult(j.result, `Results — ${esc(target)}`);
        }
        break;
      }
      if (j.status === 'error') {
        document.getElementById('liveScanIndicator').classList.remove('active');
        prog.innerHTML = `<div class="empty" style="color:var(--crit)">Scan failed: ${esc(j.result?.error || 'unknown')}</div>`;
        break;
      }
    }
  } catch(e) {
    document.getElementById('liveScanIndicator').classList.remove('active');
    prog.innerHTML = `<div class="empty" style="color:var(--crit)">Error: ${esc(e)}</div>`;
  }
  btn.disabled = false;
  CURRENT_JOB = null;
}

